   "source": ["# 02 - Data Cleaning\n", "## Cleaning and validating Bajhang Tourism Data"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["import pandas as pd\n", "import os\n", "\n", "DATA_DIR = '../data'\n", "dest = pd.read_csv(os.path.join(DATA_DIR, 'destinations.csv'))\n", "print('Missing values:')\n", "print(dest.isnull().sum())\n", "print(f'\\nDuplicates: {dest.duplicated().sum()}')"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["dest.dropna(subset=['name'], inplace=True)\n", "dest.drop_duplicates(subset=['name'], inplace=True)\n", "dest['rating'] = dest['rating'].clip(1.0, 5.0)\n", "print(f'After cleaning: {len(dest)} rows')"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["for f in ['routes.csv', 'hotels_homestays.csv', 'local_guides.csv']:\n", "    path = os.path.join(DATA_DIR, f)\n", "    df = pd.read_csv(path)\n", "    before = len(df)\n", "    df.dropna(subset=[df.columns[1]], inplace=True)\n", "    df.drop_duplicates(inplace=True)\n", "    print(f'{f}: {before} -> {len(df)} rows after cleaning')")
  }
 ],
